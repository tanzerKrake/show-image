{
  "name": "show-image",
  "displayName": "Show Image",
  "description": "Muestra una imagen personalizada en el sidebar de VS Code",
  "version": "0.0.1",
  "publisher": "krake-devs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:showImageView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Show Image",
      "properties": {
        "show-image.imagePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Ruta absoluta de la imagen que se mostrará en el sidebar. Si está vacía, se usa la imagen de ejemplo incluida en la extensión."
        }
      }
    },
    "commands": [
      {
        "command": "show-image.selectImage",
        "title": "Seleccionar imagen",
        "icon": "$(file-media)"
      },
      {
        "command": "show-image.refresh",
        "title": "Actualizar imagen",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "showImageView",
          "name": "Imagen",
          "icon": "resources/icon/icon.svg",
          "contextualTitle": "Imagen"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "show-image.selectImage",
          "when": "view == showImageView",
          "group": "navigation@1"
        },
        {
          "command": "show-image.refresh",
          "when": "view == showImageView",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "show-image.refresh",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
