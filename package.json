{
  "name": "static-image-sidebar",
  "displayName": "Show image on sidebar",
  "description": "Displays a personal photo of you or someone special in the VS Code sidebar to keep you inspired while you work.",
  "version": "1.0.1",
  "icon": "resources/icon/krake-devs.png",
  "publisher": "krake-devs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanzerKrake/show-image.git"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:showImageView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Show Image",
      "properties": {
        "show-image.imagePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the image that will be displayed in the sidebar. If empty, the sample image included in the extension is used."
        }
      }
    },
    "commands": [
      {
        "command": "show-image.selectImage",
        "title": "Select Image",
        "icon": "$(file-media)"
      },
      {
        "command": "show-image.refresh",
        "title": "Refresh Image",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "showImageView",
          "name": "Imagen",
          "icon": "resources/icon/krake-devs.png",
          "contextualTitle": "Imagen"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "show-image.selectImage",
          "when": "view == showImageView",
          "group": "navigation@1"
        },
        {
          "command": "show-image.refresh",
          "when": "view == showImageView",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "show-image.refresh",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.36.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1"
  }
}
